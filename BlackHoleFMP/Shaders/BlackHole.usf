#define PI2 6.28318530718
#define ENABLE_GRAVITATIONAL_LENSING 1

struct BlackHoleProperties
{
    float Mass; //Mass of the Black Hole
    float EventHorizon; //Black Hole Radius, Mass * 2

    Texture2D DiskTexture;
    SamplerState DiskTextureSampler;
    float DiskDensity;
    float DiskDensityBias;
    float DiskOuterRadius;
    float DiskInnerRadius;

    float FogDensity;
    float FogHeight;
    float FogExponent;

    float3 LightColor;
    float LightIntensity;
    float LightBias;

    float3 ShadowColor;
    float ShadowDensity;
    float ShadowStepSize;
    float ShadowSpread;

    float OrbitalBandSize;
    float AnimationScale;
    float AnimExponent;

    Texture2D AtlasTexture;
    SamplerState AtlasTextureSampler;

    float RMSteps;
    float ShadowSteps;
    float TransmittanceSteps;
    bool EnableGL;
};


// Position of Black Hole assumed to be at mesh origin
bool CrossedEventHorizon(float3 RayPos, BlackHoleProperties BHP)
{
    float EventHorizonSq = BHP.EventHorizon * BHP.EventHorizon;
    if (dot(RayPos, RayPos) <= EventHorizonSq)
    {
        return true;
    }

    return false;
}


//Cross product calculation
float Cross2(float3 A, float3 B)
{
    float3 Cross = cross(A, B);
    return dot(Cross, Cross);
}


//Gravitational force applied to the ray, based on the distance to the singularity and the mass of the black hole. 
//The force is applied perpendicular to the ray direction and the vector from the singularity to the ray position, creating a bending effect.
float3 GravityForce(float3 RayPos, float3 RayDir, BlackHoleProperties BHP)
{
    if (BHP.EnableGL)
    {
        RayDir = normalize(RayDir);
        float DistanceToSingularity = length(RayPos);
        float SquaredDistance = DistanceToSingularity * DistanceToSingularity;
        float3 SingularityToPos = normalize(RayPos);

        return (-3.0 * BHP.Mass) / SquaredDistance * Cross2(SingularityToPos, RayDir) * SingularityToPos;
    }
    return 0.0;
}


//Checks if the ray has crossed the accretion disk, which is assumed to be in the XY plane at Z=0.
bool CrossedAccretionDisk(float3 RayStart, float3 RayEnd)
{
    return (sign(RayStart.z) != sign(RayEnd.z));
}


//Find the intersection point of the ray and the plane of the accretion disk, used for visualization.
float2 GetZIntersect(float3 RayStart, float3 RayEnd)
{
    float3 Dir = normalize(RayEnd - RayStart);
    float RayLength = length(RayEnd - RayStart);
    float ProjectionDist = abs(RayStart.z) * RayLength / (abs(RayStart.z) + abs(RayEnd.z));
    float3 Intercept = RayStart + Dir * ProjectionDist;

    return Intercept.xy;
}


void StepRay(inout float3 RayPos, inout float3 RayDir, out float3 PreviousPosition, BlackHoleProperties BHP)
{
        //Store Previous position
        PreviousPosition = RayPos;
        
        //Calculate new ray position and direction based on gravitational force
        RayPos += RayDir + GravityForce(RayPos, RayDir, BHP);
        RayDir = normalize(RayPos - PreviousPosition);
}


bool InFogVolume(float3 RayPos, BlackHoleProperties BHP)
{
    float DistSq = dot(RayPos.xy, RayPos.xy);
    float InnerRadiusSq = BHP.DiskInnerRadius * BHP.DiskInnerRadius;
    float OuterRadiusSq = BHP.DiskOuterRadius * BHP.DiskOuterRadius;
    return (DistSq > InnerRadiusSq && DistSq < OuterRadiusSq && abs(RayPos.z) < BHP.FogHeight);
}


float DiskMask(float3 RayPos, BlackHoleProperties BHP)
{
    float Dist = length(RayPos);

    float OuterMask = 1.0 - Dist / BHP.DiskOuterRadius;

    float InnerMaskFalloff = 0.125;
    float InnerMask = saturate((Dist - BHP.DiskInnerRadius) * InnerMaskFalloff);

    return OuterMask * InnerMask;
}


float SampleFogDensity(float3 RayPos, BlackHoleProperties BHP)
{
    float f = 1.0 - (abs(RayPos.z) / BHP.FogHeight);
    float F = max(0.0, pow(f, BHP.FogExponent) * BHP.FogDensity);
    return F * DiskMask(RayPos, BHP);
}


float DensityAttenuation(float3 RayPos, BlackHoleProperties BHP)
{
    float f = 1.0 - (abs(RayPos.z) / BHP.FogHeight);
    float DensityAttenuationExponent = BHP.FogExponent * 2.0;
    return 1.0 - saturate(pow(f, DensityAttenuationExponent));
}


float CalculateLighting(float3 RayPos, BlackHoleProperties BHP)
{
    float distance = max(0.0, length(RayPos) - BHP.LightBias);
    float result = 1.0 / (distance * distance);
    return min(result, 1000);
}


float RemapValueRange(float Input, float InputLow, float InputHigh, float TargetLow, float TargetHigh)
{

    float result = (Input - InputLow) / (InputHigh - InputLow);
    result *= TargetHigh - TargetLow;
    result += TargetLow;

    return clamp(result, TargetLow, TargetHigh);
}



float2 RotateUV(float2 UV, float2 Pivot, float Speed)
{
    float Time = View.GameTime * Speed;
    float2x2 rot = { cos(Time), -sin(Time),  //Row 1
                     sin(Time), cos(Time) }; //Row 2

    UV = mul(UV + Pivot, rot);

    return UV - Pivot;
}



float4 SampleDisk(float3 RayPosition, float MipLevel, BlackHoleProperties BHP)
{
    float Distance = length(RayPosition);
    //Number of Orbital Bands
    float OrbitalBands = BHP.DiskOuterRadius / BHP.OrbitalBandSize;

    //Distances
    float Radius = max(0.0, Distance - BHP.EventHorizon);
    float RadiusOffset = Radius + BHP.OrbitalBandSize * 0.5;

    //Bands
    float Bands = ceil(Radius / BHP.OrbitalBandSize) / OrbitalBands;
    float Bands_Offset = ceil(RadiusOffset / BHP.OrbitalBandSize) / OrbitalBands;
    Bands_Offset -= 0.5 / OrbitalBands;

    //Velocities
    float OrbitalVelocity = sqrt( BHP.Mass / pow(Bands, BHP.AnimExponent));
    float OrbitalVelocityOffset = sqrt(BHP.Mass / pow(Bands_Offset, BHP.AnimExponent));

    //UVs
    float2 UV = RayPosition.xy / (BHP.DiskOuterRadius * 2.0) - 0.5; 
    float2 UV1 = RotateUV(UV, 0.5, OrbitalVelocity * BHP.AnimationScale);
    float2 UV2 = RotateUV(UV, 0.5, OrbitalVelocityOffset * BHP.AnimationScale);

    float4 DiskSample1 = BHP.DiskTexture.SampleLevel(BHP.DiskTextureSampler, UV1, MipLevel);
    float4 DiskSample2 = BHP.DiskTexture.SampleLevel(BHP.DiskTextureSampler, UV2, MipLevel);

    //Remap Radius for BlendMask
    float RadiusRemap = (Radius / BHP.OrbitalBandSize - 0.25) * PI2;
    float BandMask = sin(RadiusRemap) * 0.5 + 0.5;

    //Blend Disk Samples for final disk density
    float Disk = lerp(DiskSample2.x, DiskSample1.x, BandMask);
    
    //Calculate UVs for atlas texture
    float AtlasUV = RemapValueRange(Distance, BHP.DiskInnerRadius, BHP.DiskOuterRadius, 0.0, 1.0);
    AtlasUV += (Disk - 0.5) * 0.5;

    //sample Atlas texture for colour and bias
    float4 DiskColor = BHP.AtlasTexture.SampleLevel(BHP.AtlasTextureSampler, float2(AtlasUV, 0.5), 0);

    float Attenuation = DensityAttenuation(RayPosition, BHP);
    float Bias = max(BHP.DiskDensityBias, (1.0 - DiskColor.w));

    //Apply bias
    float Density = saturate(Disk - Bias);
    Density *= (1.0 / (1.0 - Bias));

    //Apply Attenuation
    Density = max(0.0, Density - Attenuation);
    Density *= (1.0 / (1.0 - Attenuation));

    Density *= BHP.DiskDensity * DiskMask(RayPosition, BHP);

    return float4(DiskColor.xyz, Density);
}


float SampleDiskDensity(float3 RayPosition, float MipLevel, BlackHoleProperties BHP)
{
    float Distance = length(RayPosition);
    float InvOrbitalBandSize = 1.0 / BHP.OrbitalBandSize;
    float OrbitalBands = BHP.DiskOuterRadius * InvOrbitalBandSize;

    float Radius = max(0.0, Distance - BHP.EventHorizon);
    float RadiusOffset = Radius + (BHP.OrbitalBandSize * 0.5);

    float Bands = ceil(Radius * InvOrbitalBandSize) / OrbitalBands;
    float Bands_Offset = ceil(RadiusOffset * InvOrbitalBandSize) / OrbitalBands;
    Bands_Offset -= 0.5 / OrbitalBands;

    float OrbitalVelocity = sqrt(BHP.Mass / pow(Bands, BHP.AnimExponent));
    float OrbitalVelocityOffset = sqrt(BHP.Mass / pow(Bands_Offset, BHP.AnimExponent));

    float2 UV = RayPosition.xy / (BHP.DiskOuterRadius * 2.0) - 0.5;
    float2 UV1 = RotateUV(UV, 0.5, OrbitalVelocity * BHP.AnimationScale);
    float2 UV2 = RotateUV(UV, 0.5, OrbitalVelocityOffset * BHP.AnimationScale);

    float4 DiskSample1 = BHP.DiskTexture.SampleLevel(BHP.DiskTextureSampler, UV1, MipLevel);
    float4 DiskSample2 = BHP.DiskTexture.SampleLevel(BHP.DiskTextureSampler, UV2, MipLevel);

    float RadiusRemap = (Radius * InvOrbitalBandSize - 0.25) * PI2;
    float BandMask = sin(RadiusRemap) * 0.5 + 0.5;
    float Disk = lerp(DiskSample2.x, DiskSample1.x, BandMask);

    float AtlasUV = RemapValueRange(Distance, BHP.DiskInnerRadius, BHP.DiskOuterRadius, 0.0, 1.0);
    AtlasUV += (Disk - 0.5) * 0.5;

    float DiskColorA = BHP.AtlasTexture.SampleLevel(BHP.AtlasTextureSampler, float2(AtlasUV, 0.5), 0).w;

    float Attenuation = DensityAttenuation(RayPosition, BHP);
    float Bias = max(BHP.DiskDensityBias, (1.0 - DiskColorA));

    float Density = saturate(Disk - Bias);
    Density *= (1.0 / (1.0 - Bias));

    Density = max(0.0, Density - Attenuation);
    Density *= (1.0 / (1.0 - Attenuation));

    Density *= BHP.DiskDensity * DiskMask(RayPosition, BHP);

    return Density;
}


// Lightweight transmittance-only raymarch for shared use (e.g. asteroid material).
// Marches from CameraPosition to TargetPosition and returns remaining transmittance.
float ComputeTransmittanceToPoint(float3 CameraPosition, float3 TargetPosition, BlackHoleProperties BHP)
{
    float3 RayPos = CameraPosition;
    float3 RayDir = normalize(TargetPosition - CameraPosition);
    float TotalRayLength = length(TargetPosition - CameraPosition);
    float TraveledLength = 0.0;
    float3 PreviousPosition;

    float Transmittance = 1.0;

    for (int i = 0; i < BHP.TransmittanceSteps; i++)
    {
        if (TraveledLength >= TotalRayLength)
        {
            break;
        }

        if (CrossedEventHorizon(RayPos, BHP))
        {
            return 0.0;
        }

        StepRay(RayPos, RayDir, PreviousPosition, BHP);

        float StepLength = length(RayPos - PreviousPosition);
        TraveledLength += StepLength;

        if (InFogVolume(RayPos, BHP))
        {
            float FogSample = SampleFogDensity(RayPos, BHP);
            float DiskDensity = SampleDiskDensity(RayPos, 0, BHP);
            float DensitySample = FogSample + DiskDensity;

            // Beer-Lambert attenuation keeps this stable across step counts.
            Transmittance *= exp(-DensitySample * StepLength);

            if (Transmittance < 0.0001)
            {
                break;
            }
        }
    }

    return saturate(Transmittance);
}


// Straight-line transmittance helper for materials that need stable per-pixel occlusion.
// This avoids lensing ray bending and is usually better for asteroid opacity masking.
float ComputeTransmittanceToPointLinear(float3 CameraPosition, float3 TargetPosition, BlackHoleProperties BHP)
{
    float3 Segment = TargetPosition - CameraPosition;
    float TotalRayLength = length(Segment);

    if (TotalRayLength <= 0.0001)
    {
        return 1.0;
    }

    float3 RayDir = Segment / TotalRayLength;
    float3 ToCenter = -CameraPosition;
    float BHDepth = dot(ToCenter, RayDir);

    // Only evaluate attenuation in a window around the BH depth to avoid
    // darkening the entire ray when camera is close to the disk plane.
    if (BHDepth <= 0.0 || BHDepth >= TotalRayLength)
    {
        return 1.0;
    }

    float WindowHalfSize = BHP.DiskOuterRadius;
    float StartT = max(0.0, BHDepth - WindowHalfSize);
    float EndT = min(TotalRayLength, BHDepth + WindowHalfSize);

    if (EndT <= StartT)
    {
        return 1.0;
    }

    float MarchLength = EndT - StartT;
    float StepLength = MarchLength / BHP.TransmittanceSteps;
    float3 RayPos = CameraPosition + RayDir * StartT;
    float Transmittance = 1.0;

    for (int i = 0; i < BHP.TransmittanceSteps; i++)
    {
        RayPos += RayDir * StepLength;

        if (CrossedEventHorizon(RayPos, BHP))
        {
            return 0.0;
        }

        if (InFogVolume(RayPos, BHP))
        {
            float FogSample = SampleFogDensity(RayPos, BHP);
            float DiskDensity = SampleDiskDensity(RayPos, 0, BHP);
            float DensitySample = FogSample + DiskDensity;

            Transmittance *= exp(-DensitySample * StepLength);

            if (Transmittance < 0.0001)
            {
                break;
            }
        }
    }

    return saturate(Transmittance);
}


// Full-segment linear transmittance helper.
// This reproduces the stronger fog-driven asteroid opacity behavior.
float ComputeTransmittanceToPointLinearFull(float3 CameraPosition, float3 TargetPosition, BlackHoleProperties BHP)
{
    float3 Segment = TargetPosition - CameraPosition;
    float TotalRayLength = length(Segment);

    if (TotalRayLength <= 0.0001)
    {
        return 1.0;
    }

    float3 RayDir = Segment / TotalRayLength;
    float StepLength = TotalRayLength / BHP.TransmittanceSteps;
    float3 RayPos = CameraPosition;
    float Transmittance = 1.0;

    for (int i = 0; i < BHP.TransmittanceSteps; i++)
    {
        RayPos += RayDir * StepLength;

        if (CrossedEventHorizon(RayPos, BHP))
        {
            return 0.0;
        }

        if (InFogVolume(RayPos, BHP))
        {
            float FogSample = SampleFogDensity(RayPos, BHP);
            float DiskDensity = SampleDiskDensity(RayPos, 0, BHP);
            float DensitySample = FogSample + DiskDensity;

            Transmittance *= exp(-DensitySample * StepLength);

            if (Transmittance < 0.0001)
            {
                break;
            }
        }
    }

    return saturate(Transmittance);
}



//Black hole RayMarching function
void BlackHole(inout float4 Color, inout float Mask, inout float3 Dir, float3 CameraPosition, BlackHoleProperties BHP, out float OutTransmittance)
{
    float3 RayPos = CameraPosition;
    float3 RayDir = Dir;
    float3 PreviousPosition;

    float Transmittance = 1.0;
    float3 RayColor = 0.0;

    //Begin Raymarch
    for(int i = 0; i < BHP.RMSteps; i++ )
    {
        if(CrossedEventHorizon(RayPos, BHP))
        {
            Mask = 0;
            break;
        }

        StepRay(RayPos, RayDir, PreviousPosition, BHP);

        float DensitySample = 0; 
        if(InFogVolume(RayPos, BHP))
        {
            //Sample Fog
            float FogSample = SampleFogDensity(RayPos, BHP);
            float4 FogDiskSample = SampleDisk(RayPos, 6, BHP);

            //Light Energy Calculation
            float3 LightEnergy = CalculateLighting(RayPos, BHP) * BHP.LightColor * BHP.LightIntensity;
            float3 FogEnergy = LightEnergy * FogDiskSample.xyz;

        
            //Sample Disk Density
            float4 DiskSample = SampleDisk(RayPos, 0, BHP);
            float3 DiskEnergy = LightEnergy * DiskSample.xyz;

            //Lighting
            //Initialise Lighting Variables
            float3 LightingPos = RayPos;
            float3 LightDir = normalize(-LightingPos);
            float ShadowAccumulation = 0;

            if(DiskSample.w + FogSample > 0.0001)
            {
                //Shadow Loop
                for(int j = 0; j<BHP.ShadowSteps; j++)
                {
                    //InFogVolumeCheck before shadows
                    if(InFogVolume(LightingPos, BHP))
                    {
                        float LightSampleFog = BHP.FogDensity;
                        float LightSampleDisk = SampleDisk(LightingPos, j*(BHP.ShadowSpread), BHP).w;

                        ShadowAccumulation += LightSampleFog + LightSampleDisk;
                        LightingPos += LightDir * BHP.ShadowStepSize;
                    }
                }
            }
            

            DensitySample = FogSample + DiskSample.w;

            float3 Absorption = exp(-ShadowAccumulation * BHP.ShadowDensity * BHP.ShadowColor) * DensitySample;

            RayColor += FogEnergy * Transmittance * DensitySample * Absorption;
            RayColor += DiskEnergy * Transmittance * DensitySample * Absorption;
            Transmittance *= saturate(1.0 - DensitySample);
            if(Transmittance < 0.0001) break;
        }
        
    }

    //After raymarching, the final ray direction is output
    Color = float4(RayColor, 1.0 - Transmittance);
    Dir = RayDir;
    OutTransmittance = Transmittance;
}