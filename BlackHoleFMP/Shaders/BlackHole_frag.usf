float3 CameraPositionWS = ResolvedView.TranslatedWorldCameraOrigin;
float3 CameraVectorWS = -Parameters.CameraVector;


Color = 1.0;
Dir = CameraVectorWS;

BlackHoleProperties BHP; 
Mask = 1.0;
BHP.Mass = Mass;
BHP.EventHorizon = Mass*2.0;



BlackHole(Color, Mask, Dir, CameraPositionWS, BHP);

return 1.0;